---
import '../styles/global.scss';

const title = 'Live Voice';
const description = 'Browser-native real-time voice rooms.';
---
<!doctype html>
<html lang="id-ID">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08111f" />
    <meta name="color-scheme" content="dark" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/icon-192.png" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <title>{title}</title>
  </head>
  <body>
    <a class="gaga-skip-link" href="#main" data-i18n="skipToContent">Lewati ke konten</a>
    <div id="offline-banner" class="gaga-offline-banner" role="status" hidden data-i18n="offline">Anda sedang offline.</div>

    <header class="gaga-app-header">
      <a class="gaga-brand" href="/" aria-label="Beranda Live Voice" data-i18n-aria="homeLabel">
        <span class="gaga-brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
        <span>
          <strong>Live Voice</strong>
          <small data-i18n="brandTagline">Ruang suara instan. Tanpa akun.</small>
        </span>
      </a>
      <div class="gaga-header-actions">
        <button id="install-button" class="gaga-button gaga-button--quiet" type="button" hidden data-i18n="install">Pasang aplikasi</button>
        <select id="locale-select" class="gaga-select gaga-select--compact" aria-label="Bahasa">
          <option value="id-ID">ID</option>
          <option value="en-US">EN</option>
        </select>
      </div>
    </header>

    <main id="main" class="gaga-app-shell">
      <section id="join-view" class="gaga-panel gaga-join-panel" aria-labelledby="join-title">
        <div class="gaga-eyebrow">LIVE VOICE 1.3</div>
        <h1 id="join-title" data-i18n="landingTitle">Masuk ke ruang suara</h1>
        <p class="gaga-lead" data-i18n="landingText">Masukkan nama dan ruang. Mikrofon hanya aktif setelah Anda memberikan izin.</p>

        <form id="join-form" class="gaga-form">
          <label for="display-name" data-i18n="displayName">Nama tampilan</label>
          <input id="display-name" name="displayName" autocomplete="name" maxlength="40" required />

          <label for="room-id" data-i18n="room">Ruang</label>
          <div class="gaga-room-input-wrap">
            <span aria-hidden="true">#</span>
            <input id="room-id" name="roomId" inputmode="text" maxlength="48" required />
          </div>

          <label for="voice-mode" data-i18n="mode">Mode</label>
          <select id="voice-mode" class="gaga-select" name="voiceMode">
            <option value="open-mic" data-i18n="openMic">Mikrofon terbuka</option>
            <option value="push-to-talk" data-i18n="pushToTalk">Tekan untuk bicara</option>
          </select>

          <label for="room-mode" data-i18n="roomMode">Jenis ruang</label>
          <select id="room-mode" class="gaga-select" name="roomMode">
            <option value="open" data-i18n="modeOpen">Terbuka</option>
            <option value="workshop" data-i18n="modeWorkshop">Workshop</option>
            <option value="learning" data-i18n="modeLearning">Belajar</option>
            <option value="gaming" data-i18n="modeGaming">Gaming</option>
          </select>

          <button id="join-button" class="gaga-button gaga-button--primary gaga-button--large" type="submit" data-i18n="join">Masuk ruang</button>
        </form>

        <div id="error-box" class="gaga-error" role="alert" tabindex="-1" hidden></div>
        <p class="gaga-privacy-note"><span aria-hidden="true">◌</span> <span data-i18n="privacy">Audio berjalan langsung antar peserta. Server hanya mengatur ruang.</span></p>
      </section>

      <section id="room-view" class="gaga-room-layout" aria-labelledby="room-title" hidden>
        <div class="gaga-panel gaga-room-main">
          <div class="gaga-room-heading">
            <div>
              <div class="gaga-eyebrow" data-i18n="room">Ruang</div>
              <h1 id="room-title">general</h1>
              <p id="room-purpose" class="gaga-room-purpose">Open Conversation</p>
              <p class="gaga-room-context">
                <span id="room-activity">Preparing room</span>
                <span aria-hidden="true">•</span>
                <span id="room-count">1 person here</span>
              </p>
            </div>
            <button id="copy-link" class="gaga-button gaga-button--quiet" type="button" data-i18n="copyLink">Salin tautan</button>
          </div>

          <div class="gaga-status-strip" aria-live="polite">
            <span class="gaga-status-item"><span class="gaga-status-dot" aria-hidden="true"></span><span data-i18n="connection">Status</span>: <strong id="connection-status" data-state="connecting">Menyiapkan</strong></span>
            <span class="gaga-status-divider" aria-hidden="true"></span>
            <span class="gaga-status-item"><span data-i18n="quality">Suara</span>: <strong id="quality-status" data-quality="unknown">Belum tersedia</strong></span>
            <span class="gaga-status-divider" aria-hidden="true"></span>
            <span class="gaga-status-item"><span data-i18n="roomPulse">Denyut ruang</span>: <strong id="room-pulse">Ruang tenang</strong></span>
            <span id="optimizing-label" class="gaga-status-pill" hidden data-i18n="optimizingVoice">Mengoptimalkan suara</span>
          </div>

          <div id="facilitation-controls" class="gaga-facilitation-controls" aria-label="Kontrol sesi" data-i18n-aria="sessionControls" hidden>
            <button id="start-session-button" class="gaga-mini-button" type="button" data-i18n="startSession">Mulai sesi</button>
            <button id="open-discussion-button" class="gaga-mini-button" type="button" data-i18n="openDiscussion">Buka diskusi</button>
            <button id="quiet-room-button" class="gaga-mini-button" type="button" data-i18n="quietRoomAction">Tenangkan ruang</button>
            <button id="end-session-button" class="gaga-mini-button" type="button" data-i18n="endSession">Akhiri sesi</button>
          </div>

          <ul id="social-events" class="gaga-social-events" aria-live="polite"></ul>

          <div class="gaga-participant-section">
            <div class="gaga-section-title">
              <h2 data-i18n="participants">Peserta</h2>
              <span id="capacity-label" class="gaga-capacity">max 10</span>
            </div>
            <ul id="participant-list" class="gaga-participant-list" aria-live="polite"></ul>
          </div>

          <div class="gaga-controls" aria-label="Kontrol suara" data-i18n-aria="voiceControls">
            <button id="mute-button" class="gaga-button gaga-button--control" type="button" aria-pressed="false" data-i18n="unmute">Aktifkan mikrofon</button>
            <button id="ptt-button" class="gaga-ptt-button" type="button" aria-pressed="false" hidden>
              <span class="gaga-ptt-wave" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
              <strong data-i18n="holdToTalk">Tahan untuk bicara</strong>
            </button>
            <button id="leave-button" class="gaga-button gaga-button--danger" type="button" data-i18n="leave">Keluar</button>
          </div>
          <p id="ptt-hint" class="gaga-hint" hidden data-i18n="pttHint">Tahan tombol atau Space untuk berbicara.</p>
          <button id="enable-audio-button" class="gaga-button gaga-button--quiet" type="button" hidden data-i18n="enableAudio">Aktifkan audio</button>
        </div>

        <aside class="gaga-panel gaga-room-side" aria-label="Informasi ruang" data-i18n-aria="roomInformation">
          <div class="gaga-side-stat">
            <span>Audio</span>
            <strong>Jernih</strong>
          </div>
          <div class="gaga-side-stat">
            <span>Room</span>
            <strong>Bersama</strong>
          </div>
          <div class="gaga-side-stat">
            <span>Flow</span>
            <strong>Adaptive</strong>
          </div>
          <div class="gaga-side-divider"></div>
          <pre id="diagnostics-panel" class="gaga-diagnostics" hidden aria-label="Diagnostics"></pre>
          <div id="audio-output-wrap" class="gaga-output-select" hidden>
            <label for="audio-output" data-i18n="audioOutput">Keluaran audio</label>
            <select id="audio-output" class="gaga-select gaga-select--compact">
              <option value="default" data-i18n="defaultOutput">Keluaran sistem</option>
            </select>
          </div>
          <p data-i18n="privacy">Audio berjalan langsung antar peserta. Server hanya mengatur ruang.</p>
        </aside>
      </section>
    </main>

    <div id="remote-audio-bin" hidden aria-hidden="true"></div>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
