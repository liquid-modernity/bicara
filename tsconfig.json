{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@live-voice/shared-types": ["packages/shared-types/src/index.ts"],
      "@live-voice/voice-domain": ["packages/voice-domain/src/index.ts"],
      "@live-voice/signaling-client": ["packages/signaling-client/src/index.ts"],
      "@live-voice/rtc-core": ["packages/rtc-core/src/index.ts"],
      "@live-voice/gaga-bridge": ["packages/gaga-bridge/src/index.ts"]
    }
  }
}
