{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "live-voice-signaling",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "../../apps/web/dist"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "MAX_PARTICIPANTS": "10",
    "TURN_TTL_SECONDS": "43200",
    "ALLOWED_ORIGINS": "http://localhost:4321,http://127.0.0.1:4321"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "VoiceRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "VoiceRoom"
      ]
    }
  ]
}
